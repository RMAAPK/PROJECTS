<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Executive Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_overlay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Overlay"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip" />
    </LinearLayout>

    <!-- Status Sub-bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_model_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Replicate (Llama 3 / DeepSeek)"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_shizuku_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Shizuku UID 2000"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_vault_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● SQLite Vault Armed"
            android:textColor="@color/accent_purple"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Action Chips Carousel -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_cnc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔨 CNC &amp; Spindle Defense"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_trademarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ Trademarks &amp; AHYEON"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_fargo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐕 Fargo &amp; Haseeb"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_forge_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Forge AI YC W27"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_shizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Real Shizuku Dump"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_safety"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Test Biometric Safety"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Chat List -->
    <ListView
        android:id="@+id/list_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingHorizontal="16dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <!-- Bottom Input Container (Pin-pinned to top of Android keyboard) -->
    <LinearLayout
        android:id="@+id/bottom_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_input"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:background="@null"
                android:textSize="14sp"
                android:maxLines="4"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend|flagNoExtractUi" />

            <ImageButton
                android:id="@+id/btn_voice_input"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@null"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Voice Input" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_send_message"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="➤"
            android:textSize="18sp"
            android:textColor="@color/bg_dark"
            android:background="@drawable/btn_send" />
    </LinearLayout>
</LinearLayout>
